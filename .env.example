# PostgreSQL configuration used by docker-compose.yml (optional override via .env)
POSTGRES_USER=qsm_user
POSTGRES_PASSWORD=qsm_secret_password
POSTGRES_DB=qsm_db

# Application database connection string (defaults to local async SQLite when unset)
# DATABASE_URL=postgresql+psycopg://qsm_user:qsm_secret_password@localhost:5432/qsm_db
DATABASE_URL=sqlite+aiosqlite:///./qsm.db
